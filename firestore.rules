// Firestore security rules. Paste into Firebase console → Firestore Database → Rules → Publish.
// players/{uid}:  the leaderboard card. Every signed-in player can read all of them, only you can write yours.
// progress/{uid}: your full progress. Only you can read and write it.
// matches/{id}:   a duel. Every signed-in player can read it (the link is enough to join);
//                 everybody may only add their OWN result, once, and nothing else can be changed.
// quizduels/{id}: a quiz duel between 2 players (6 rounds). Only the player whose turn it is may save,
//                 and only the rounds + whose turn it is next.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 24;
    }
    match /matches/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() <= 20
        && request.resource.data.questions.size() <= 30
        && request.resource.data.results.keys().hasOnly([request.auth.uid]);
      allow update: if request.auth != null
        && !(request.auth.uid in resource.data.results)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['results', 'names', 'participants'])
        && request.resource.data.results.diff(resource.data.results).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.participants.hasAll(resource.data.participants)
        && request.resource.data.participants.size() <= resource.data.participants.size() + 1
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() <= 20;
    }
    match /quizduels/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.players.size() == 2
        && request.resource.data.players[0] == request.auth.uid
        && request.resource.data.players[1] != request.auth.uid
        && request.resource.data.rounds.size() == 1;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.players
        && resource.data.turn == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rounds', 'turn', 'updatedAt'])
        && request.resource.data.rounds.size() >= resource.data.rounds.size()
        && request.resource.data.rounds.size() <= 6;
    }
    match /progress/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.data is string;
    }
  }
}
